  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --dark-100: #191c34;
      --dark-95: #21264a;
      --dark-90: #1a1f40;
      --dark-70: #15192b;
      --dark-50: #282e54;
      --grey-primary: #818ebb;
      --grey-secondary: #5f6892;
      --accent-blue: #3656ff;
      --white: #ffffff;
    }

    html, body {
      min-height: 100vh;
    }

    body {
      font-family: "Titillium Web", "Segoe UI", system-ui, -apple-system, sans-serif;
      background-color: var(--dark-90);
      background-image:
        radial-gradient(ellipse 80% 50% at 50% -10%, rgba(54, 86, 255, 0.22), transparent 70%),
        radial-gradient(ellipse 60% 40% at 50% 110%, rgba(21, 25, 43, 0.9), transparent 70%);
      color: var(--white);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 1.5rem 1rem;
    }

    .card {
      background: var(--dark-95);
      border: 1px solid rgba(129, 142, 187, 0.1);
      border-radius: 12px;
      box-shadow: 0 12px 40px rgba(0, 0, 0, 0.35);
      padding: 2.5rem 2.75rem 2rem;
      max-width: 460px;
      width: 100%;
      text-align: center;
    }

    .logo {
      width: 152px;
      height: auto;
      margin-bottom: 1.75rem;
    }

    h1 {
      font-size: 1.35rem;
      font-weight: 700;
      letter-spacing: 0.01em;
      margin-bottom: 0.4rem;
    }

    .subtitle {
      font-size: 0.9rem;
      font-weight: 400;
      color: var(--grey-primary);
      line-height: 1.55;
      margin-bottom: 1.75rem;
    }

    .challenge-slot {
      background: var(--dark-50);
      border: 1px solid rgba(129, 142, 187, 0.12);
      border-radius: 8px;
      padding: 1rem;
      min-height: 100px;
      display: flex;
      align-items: center;
      justify-content: center;
      animation: slot-pulse 2.4s ease-in-out infinite;
    }

    @keyframes slot-pulse {
      0%, 100% { border-color: rgba(129, 142, 187, 0.12); }
      50%      { border-color: rgba(54, 86, 255, 0.45); }
    }

    .noscript-warning {
      background: rgba(242, 72, 34, 0.12);
      border: 1px solid rgba(242, 72, 34, 0.5);
      border-radius: 8px;
      padding: 0.85rem 1rem;
      font-size: 0.85rem;
      color: #ffb4a3;
      margin-bottom: 1rem;
      line-height: 1.5;
    }

    .meta {
      margin-top: 1.75rem;
      font-size: 0.72rem;
      color: var(--grey-secondary);
      line-height: 1.7;
    }

    .meta code {
      font-family: inherit;
      color: var(--grey-primary);
    }

    .footer {
      margin-top: 1.5rem;
      font-size: 0.72rem;
      color: var(--grey-secondary);
    }

    @media (max-width: 480px) {
      .card { padding: 2rem 1.25rem 1.5rem; }
    }
  </style>
<meta http-equiv="refresh" content="360"></head>
